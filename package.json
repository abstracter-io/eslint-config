{
  "name": "@abstracter/eslint-config",
  "version": "0.0.0",
  "private": false,
  "description": "Common eslint configuration for common env/stacks",
  "files": [
    "lib/**"
  ],
  "main": "lib/index.js",
  "scripts": {
    "outdated": "npx npm-check -u",
    "lint": "eslint --format pretty --fix",
    "lint:all": "npm run lint -- .",
    "prepare": "husky",
    "release": "node scripts/release.mjs"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "keywords": [
    "eslint",
    "eslintconfig"
  ],
  "author": "Elad Chen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abstracter-io/eslint-config.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@abstracter/atomic-release": "^2.2.0",
    "@commitlint/cli": "^19.4.1",
    "@commitlint/config-conventional": "^19.4.1",
    "@commitlint/cz-commitlint": "^19.4.0",
    "@eslint-react/eslint-plugin": "^5.20.1",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.8.1",
    "eslint-formatter-pretty": "^7.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "git-cz": "^4.9.0",
    "husky": "^9.1.5",
    "lint-staged": "^15.2.10",
    "micromatch": "^4.0.8",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint-formatter-pretty": "^7.1.0",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-promise": "^7.3.0",
    "globals": "^17.9.0",
    "typescript-eslint": "^8.66.0"
  },
  "peerDependencies": {
    "@eslint-react/eslint-plugin": "^5.20.1",
    "eslint": "^9.39.0 || ^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1"
  },
  "peerDependenciesMeta": {
    "@eslint-react/eslint-plugin": {
      "optional": true
    },
    "eslint-plugin-react-hooks": {
      "optional": true
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./react": "./lib/react.mjs",
    "./package.json": "./package.json"
  }
}
